    "http://localhost:8080/auth/realms/CX-Central/broker/ebw-connector/endpoint"
   ],
   "attributes": {
    "pkce.code.challenge.method": "S256"
   },
   "defaultClientScopes": [
    "profile"
   ],
   "optionalClientScopes": [],
   "protocolMappers": [],
   "secret": "test-only-stand-in-secret"
  }
