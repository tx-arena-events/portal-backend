{
 "realm": "TEST-EBW",
 "enabled": true,
 "sslRequired": "external",
 "registrationAllowed": false,
 "accessTokenLifespan": 300,
 "eventsEnabled": true,
 "eventsListeners": [
  "jboss-logging"
 ],
 "enabledEventTypes": [
  "LOGIN",
  "LOGIN_ERROR",
  "CODE_TO_TOKEN",
  "CODE_TO_TOKEN_ERROR"
 ],
 "requiredActions": [
  {
   "alias": "VERIFY_PROFILE",
   "name": "Verify Profile",
   "providerId": "VERIFY_PROFILE",
   "enabled": false,
   "defaultAction": false,
   "priority": 90,
   "config": {}
  }
 ],
 "clients": [
  {
   "clientId": "portal-iam",
   "name": "Portal IAM of CX-Central",
   "enabled": true,
   "publicClient": false,
   "protocol": "openid-connect",
   "standardFlowEnabled": true,
   "implicitFlowEnabled": false,
   "directAccessGrantsEnabled": false,
   "serviceAccountsEnabled": false,
   "clientAuthenticatorType": "client-jwt",
   "redirectUris": [
    "http://localhost:8080/auth/realms/CX-Central/broker/ebw-connector/endpoint"
   ],
   "attributes": {
    "pkce.code.challenge.method": "S256",
    "use.jwks.url": "true",
    "jwks.url": "http://localhost:8080/auth/realms/CX-Central/protocol/openid-connect/certs",
    "token.endpoint.auth.signing.alg": "ES256"
   },
   "defaultClientScopes": [
    "profile"
   ],
   "optionalClientScopes": [],
   "protocolMappers": []
  },
  {
