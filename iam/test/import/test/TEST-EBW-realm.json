    "token.endpoint.auth.signing.alg": "ES256"
   },
   "defaultClientScopes": [
    "profile"
   ],
   "optionalClientScopes": [],
   "protocolMappers": [
    {
     "name": "company_id",
     "protocol": "openid-connect",
     "protocolMapper": "oidc-hardcoded-claim-mapper",
     "consentRequired": false,
     "config": {
      "claim.name": "company_id",
      "claim.value": "c0000099-0000-4000-8000-000000000099",
      "jsonType.label": "String",
      "id.token.claim": "true",
      "access.token.claim": "false"
     }
    },
    {
     "name": "bpn",
     "protocol": "openid-connect",
     "protocolMapper": "oidc-hardcoded-claim-mapper",
     "consentRequired": false,
     "config": {
      "claim.name": "bpn",
      "claim.value": "BPNL0000000000XX",
      "jsonType.label": "String",
      "id.token.claim": "true",
      "access.token.claim": "false"
     }
    },
    {
     "name": "email",
     "protocol": "openid-connect",
     "protocolMapper": "oidc-hardcoded-claim-mapper",
     "consentRequired": false,
     "config": {
      "claim.name": "email",
      "claim.value": "not-for-the-account@example.org",
      "jsonType.label": "String",
      "id.token.claim": "true",
      "access.token.claim": "false"
     }
    }
   ]
  },
  {
   "clientId": "portal-iam-secret",
   "name": "Case 6: only a client secret",
   "enabled": true,
   "publicClient": false,
   "protocol": "openid-connect",
   "standardFlowEnabled": true,
   "implicitFlowEnabled": false,
   "directAccessGrantsEnabled": false,
   "serviceAccountsEnabled": false,
